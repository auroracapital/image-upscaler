    "@uppy/core": "^4.3.0",
    "@uppy/dashboard": "^4.3.0",
    "@uppy/react": "^4.1.0",
    "@uppy/tus": "^4.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
